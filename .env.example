# Shopify app credentials (Partners dashboard → app → API credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://pulse-flow-mu.vercel.app
# PulseFlow writes: it creates discounts and reads marketing consent.
SHOPIFY_SCOPES=read_orders,read_products,read_customers,write_discounts,read_discounts
SHOPIFY_API_VERSION=2026-07

# Signs the pf_session cookie. Defaults to SHOPIFY_API_SECRET; set it separately
# in production so rotating one does not invalidate the other.
APP_SESSION_SECRET=

# Neon Postgres. DIRECT_URL is the non-pooled connection Prisma migrations need.
DATABASE_URL=
DIRECT_URL=

# Bearer token the scheduler endpoint requires.
CRON_SECRET=

# Email delivery. RESEND_FROM_EMAIL is the shared fallback identity used until a
# merchant verifies their own sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=PulseFlow <onboarding@resend.dev>

# Claude API key, for compiling a plain-language description into a workflow.
# Without it the app still works — the description box is simply not shown, and
# templates remain the way to create an automation.
ANTHROPIC_API_KEY=
